# Copiar a .env.local y completar con los valores del proyecto de Supabase.
# .env.local nunca se commitea (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcionales, solo para tareas administrativas puntuales (crear/ascender
# usuarios, correr migraciones a mano) — la app en sí no las usa en runtime.
# Son sensibles: no las commitees, no las pegues en ningún chat.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
